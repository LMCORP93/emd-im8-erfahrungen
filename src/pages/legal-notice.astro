---
import BaseLayout from '@/layouts/BaseLayout.astro';
import config from '@/data/site.config';
const legalPageTitle = 'Impressum';
const legalPageDescription = 'Rechtliche Hinweise, Herausgeberinformationen und Affiliate-Hinweis für diese Website.';
const legalPageUrl = new URL(Astro.url.pathname, config.domain).toString();
---
<BaseLayout title={`Impressum | ${config.siteName}`} description={legalPageDescription}>
  <script type="application/ld+json" slot="json-ld" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebPage', name: legalPageTitle, headline: legalPageTitle, description: legalPageDescription, url: legalPageUrl, isPartOf: { '@type': 'WebSite', name: config.siteName, url: config.domain } })} />
  <main class="padding-section-medium" style="background-color:#ffffff;">
    <div class="container-large" style="max-width:72rem;margin:0 auto;">
      <h1 style="font-size:clamp(1.75rem,1.2rem + 2.75vw,2.5rem);color:#242424;margin-bottom:2rem;">Impressum</h1>
      <div style="color:#333;line-height:1.8;font-size:14px;max-width:48rem;">
        <h2>1. Herausgeber</h2><p>Die Website <strong>{config.siteName}</strong> wird herausgegeben von:</p><p><strong>Éditeur du site</strong><br />Share capital: 10,000.00 MAD<br />ICE: 003858984000079<br />RC: 174701 - Marrakech Trade Register<br />Tax ID: 71070947<br />Quartier Industriel Sidi Ghanem, Lot N°208, Bureau N°DH7, Marrakech, Marokko<br />E-Mail: Kontakt über die Angaben im Impressum</p>
        <h2>2. Hosting</h2><p>Hosting-Anbieter: Cloudflare, Inc., 101 Townsend Street, San Francisco, CA 94107, USA.</p>
        <h2>3. Affiliate-Hinweis</h2><p>Diese Website kann Affiliate-Links enthalten. Wenn du über einen solchen Link kaufst, kann eine Provision entstehen. Für dich ändert sich der Preis dadurch nicht.</p>
        <h2>4. Medizinischer Hinweis</h2><p>Die Inhalte dienen nur der Information und ersetzen keine medizinische Beratung, Diagnose oder Behandlung. Nahrungsergänzungsmittel sollten individuell geprüft werden.</p>
        <h2>5. Kontakt</h2><p>Für Fragen zu dieser Website: Kontakt über die Angaben im Impressum</p>
      </div>
    </div>
  </main>
</BaseLayout>
